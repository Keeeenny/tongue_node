import { Request, Response, NextFunction } from "express";
import { isString, toNumber } from "../utils/validators";
import { UserField } from "../utils/types";

const MIN_AGE = 16;
const MAX_AGE = 120;

const USER_ALLOWED_FIELDS = [UserField.NICKNAME, UserField.AGE, UserField.CITY];

export const validatePostUser = (
  req: Request,
  res: Response,
  next: NextFunction,
): void => {
  console.log("validate postUser called");

  validateUserFields(req.body, USER_ALLOWED_FIELDS);
  checkAge(req.body.age);

  next();
};

export const validatePatchUser = (
  req: Request,
  res: Response,
  next: NextFunction,
): void => {
  console.log("validate patchUser called");
  const bodyData = req.body;
  const id = req.params.id;

  checkNumber(id, UserField.ID);
  validateUserFields(bodyData, USER_ALLOWED_FIELDS);
  checkAge(req.body.age);

  next();
};

export const validateDeleteUser = (
  req: Request,
  res: Response,
  next: NextFunction,
): void => {
  console.log("validate deleteUser called");
  const id = req.params.id;
  checkNumber(id, UserField.ID);
  console.log(id);

  next();
};

function checkString(value: unknown, field: string): void {
  const isStringValid: boolean = isString(value);
  if (!isStringValid) {
    const err: any = new Error(
      `Bad request: ${field} is not a string or is empty`,
    );
    err.statusCode = 400;
    throw err;
  }
}

function checkNumber(value: unknown, field: string): void {
  const isNumbeValid: boolean = !isNaN(toNumber(value));

  if (!isNumbeValid) {
    const err: any = new Error(
      `Bad request: ${field} is not a valid positive integer`,
    );
    err.statusCode = 400;
    throw err;
  }
}

function checkAge(value: number): void {
  const age = toNumber(value);

  if (age < MIN_AGE || age > MAX_AGE) {
    const err: any = new Error(
      `Bad request: Age must be between ${MIN_AGE} and ${MAX_AGE}`,
    );
    err.statusCode = 400;
    throw err;
  }
}

function validateUserFields(
  bodyData: Record<string, unknown>,
  allowedFields: string[],
): void {
  if (
    !bodyData ||
    typeof bodyData !== "object" ||
    Object.keys(bodyData).length === 0
  ) {
    const err: any = new Error("Bad request: Request body is missing or empty");
    err.statusCode = 400;
    throw err;
  }
  
  const keys = Object.keys(bodyData);

  for (const property of keys) {
    if (!allowedFields.includes(property)) {
      const err: any = new Error(`Bad request: Invalid field '${property}'`);
      err.statusCode = 400;
      throw err;
    }

    if (property === UserField.NICKNAME) {
      checkString(bodyData[property], UserField.NICKNAME);
    }
    if (property === UserField.AGE) {
      checkNumber(bodyData[property], UserField.AGE);
    }
    if (property === UserField.CITY) {
      checkString(bodyData[property], UserField.CITY);
    }
  }
}
