  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "test": "mocha -r ts-node/register -r dotenv/config \"src/**/*.test.ts\"",
    "test:watch": "mocha -r ts-node/register -r dotenv/config \"src/**/*.test.ts\" --watch --watch-files src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keeeenny/tongue-node.git"
  },
